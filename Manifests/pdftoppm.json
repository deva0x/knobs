{
  "schemaVersion": 1,
  "id": "pdftoppm",
  "name": "pdftoppm",
  "summary": "Save PDF pages as PNG or JPEG images. Part of Poppler.",
  "executable": "pdftoppm",
  "install": { "brew": "poppler" },
  "homepage": "https://poppler.freedesktop.org",
  "symbol": "photo.on.rectangle",
  "helpArguments": ["-h"],
  "tint": "yellow",
  "tasks": [
    {
      "id": "page-to-image",
      "title": "Save a page as an image",
      "summary": "Turn one page of a PDF into a PNG or JPEG picture.",
      "symbol": "photo",
      "fields": [
        { "id": "input", "label": "PDF", "kind": "inputFile", "contentTypes": ["com.adobe.pdf"] },
        { "id": "page", "label": "Page", "kind": "integer", "default": 1, "minimum": 1, "maximum": 9999 },
        { "id": "format", "label": "Format", "kind": "choice", "default": "png",
          "options": [
            { "value": "png", "label": "PNG" },
            { "value": "jpg", "label": "JPEG" }
          ] },
        { "id": "resolution", "label": "Sharpness", "kind": "choice", "default": "150",
          "options": [
            { "value": "72", "label": "Screen (72 dpi)" },
            { "value": "150", "label": "Standard (150 dpi)" },
            { "value": "300", "label": "Print (300 dpi)" }
          ] }
      ],
      "output": { "template": "{input.stem} page {page}.{format}", "nextTo": "input" },
      "arguments": [
        { "if": "format", "equals": "jpg", "then": ["-jpeg"], "else": ["-png"] },
        "-r", "{resolution}", "-f", "{page}", "-l", "{page}", "-singlefile",
        "{extra}", "{input}", "{output.base}"
      ]
    },
    {
      "id": "every-page-to-images",
      "title": "Save every page as images",
      "summary": "Turn each page of a PDF into its own PNG or JPEG picture, in a new folder.",
      "symbol": "photo.stack",
      "fields": [
        { "id": "input", "label": "PDF", "kind": "inputFile", "contentTypes": ["com.adobe.pdf"] },
        { "id": "format", "label": "Format", "kind": "choice", "default": "png",
          "options": [
            { "value": "png", "label": "PNG" },
            { "value": "jpg", "label": "JPEG" }
          ] },
        { "id": "resolution", "label": "Sharpness", "kind": "choice", "default": "150",
          "options": [
            { "value": "72", "label": "Screen (72 dpi)" },
            { "value": "150", "label": "Standard (150 dpi)" },
            { "value": "300", "label": "Print (300 dpi)" }
          ] }
      ],
      "output": { "template": "{input.stem} pages", "nextTo": "input", "newFolder": true },
      "arguments": [
        { "if": "format", "equals": "jpg", "then": ["-jpeg"], "else": ["-png"] },
        "-r", "{resolution}", "{extra}", "{input}", "{output}/page"
      ]
    }
  ]
}
