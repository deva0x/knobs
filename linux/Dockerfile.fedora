# The Fedora build environment for the .rpm, used only on this Mac through OrbStack or Docker. Fedora's own
# Swift (6.3) and GTK (4.22) build the binary, so it links against exactly what Fedora users have.
FROM fedora:44
RUN dnf install -y --setopt=install_weak_deps=False \
      swift-lang gtk4-devel libadwaita-devel sqlite-devel pkgconf-pkg-config rpm-build binutils \
    && dnf clean all
# SwiftPM clones the app's dependencies with git. A separate layer, so adding it reused the slow Swift download.
RUN dnf install -y --setopt=install_weak_deps=False git-core && dnf clean all
