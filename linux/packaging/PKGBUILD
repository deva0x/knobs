# Maintainer: Devaprasad T P <https://github.com/deva0x/knobs>
# Knobs for Arch Linux. Arch has no Swift toolchain in its official repositories, so, like other "-bin"
# packages, this one installs the binary built in the Ubuntu container, which carries Swift's runtime, and
# uses Arch's own GTK. scripts/linux.sh package fills in the version and the checksum, and also writes this
# file with its .SRCINFO for the AUR (DEC-017).
# The AUR's "knobs" is a different program that also installs /usr/bin/knobs, hence the name and the conflict.
# The local build copies the tarball next to this file, so makepkg uses it instead of downloading it.
pkgname=knobs-gui-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="Command-line tools, as simple windows"
arch=('x86_64')
url="https://github.com/deva0x/knobs"
license=('MIT')
depends=('gtk4' 'libadwaita' 'glib2' 'hicolor-icon-theme' 'glibc' 'gcc-libs')
optdepends=(
    'ffmpeg: video and audio tasks'
    '7zip: archive tasks'
    'imagemagick: image tasks'
    'pandoc-cli: document conversion'
    'perl-image-exiftool: photo details'
    'ghostscript: PDF tasks'
    'rsync: folder copies'
    'yt-dlp: downloads'
    'ocrmypdf: searchable PDFs (AUR)'
    'whisper.cpp: transcription (AUR)'
)
provides=('knobs-gui')
conflicts=('knobs-gui' 'knobs' 'knobs-bin')
source=("$url/releases/download/v$pkgver/knobs-$pkgver-linux-$CARCH.tar.gz")
sha256sums=('@SHA256@')
# The binary is already stripped; makepkg's own strip and debug split would only repeat that.
options=('!strip' '!debug')

package() {
    cp -a "$srcdir/knobs/." "$pkgdir/"
    # Arch keeps each package's license under the package's own name.
    mv "$pkgdir/usr/share/licenses/knobs" "$pkgdir/usr/share/licenses/$pkgname"
}
